# ─────────────────────────────────────────────────────────────────
# Style Saplings — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is listed in .gitignore.
# The authoritative values for production are stored in Vercel
# (Dashboard → style-saplings → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Project ref: igjltsdmlqxziokjeuwa  (ap-southeast-1 / Singapore)
# Retrieve from: Supabase Dashboard → Settings → API
VITE_SUPABASE_PROJECT_ID="igjltsdmlqxziokjeuwa"
VITE_SUPABASE_URL="https://igjltsdmlqxziokjeuwa.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key from Supabase dashboard>"

# ── Razorpay ──────────────────────────────────────────────────────
# Publishable/public key only (prefix rzp_live_ for production).
# The secret key lives in Supabase edge function secrets — never here.
# Retrieve from: Razorpay Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID="rzp_live_<your-publishable-key>"

# ─────────────────────────────────────────────────────────────────
# The following are server-side secrets stored in Supabase Edge
# Function secrets (Supabase Dashboard → Settings → Edge Functions).
# They are listed here for reference ONLY — do not put them in .env.
#
#   RAZORPAY_KEY_SECRET        Razorpay HMAC signing key
#   RESEND_API_KEY             Resend email API key  *** NOT YET SET — required before launch ***
#   SHIPROCKET_EMAIL           shamvi.sharma@gmail.com
#   SHIPROCKET_PASSWORD        Shiprocket account password
#   SUPABASE_SERVICE_ROLE_KEY  Auto-injected by Supabase into every edge function
